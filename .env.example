# Copy to .env (gitignored) and fill in. The daemon loads it at startup;
# restart after editing. Never commit the filled file.

# X API — a Read+Write app from developer.x.com (User authentication
# settings -> OAuth 1.0a). Darryl posts approved [x] cards with these.
DM_X_API_KEY=
DM_X_API_SECRET=
DM_X_ACCESS_TOKEN=
DM_X_ACCESS_SECRET=

# Daemon knobs (optional — these are the usual runtime settings)
DM_CLAIM=1
DM_HEARTBEAT_SECONDS=90

# Per-seat overrides (optional), e.g.:
# DM_SEAT_GHOSTWRITER_CONNECTOR=codex
# DM_SEAT_GHOSTWRITER_MODEL=gpt-5
